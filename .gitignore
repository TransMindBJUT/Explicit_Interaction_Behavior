# Publish only the reviewed project page and its assets.
/*
!/.gitignore
!/README.md
!/docs/
/docs/*
!/docs/index.html
!/docs/.nojekyll
!/docs/static/
/docs/static/*
!/docs/static/academic.css
!/docs/static/app.js
!/docs/static/case-preview.js
!/docs/static/interaction-cases.html
!/docs/static/favicon.svg
!/docs/static/images/
/docs/static/images/*
!/docs/static/images/*.jpg
!/docs/static/images/intersection-concept.svg
!/docs/static/images/intersection-animated.svg
!/docs/static/images/proximity-concept.svg
!/docs/static/images/proximity-animated.svg

# Manuscripts remain local.
*.pdf
